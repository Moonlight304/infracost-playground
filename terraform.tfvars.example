# -----------------------------------------------
# Example: Linux VM
# -----------------------------------------------
resource_group_name = "my-rg"
location            = "East US"
vm_name             = "my-linux-vm"
vm_size             = "Standard_B2s"
os_type             = "linux"
admin_username      = "azureuser"
ssh_public_key      = "ssh-rsa AAAA...your-public-key-here"

